<div class="container-fluid p-3 bg-white">
  <div class="row align-items-center">
    <div class="col-md-3 text-success"><h3 class="mb-0"><i class="fa-solid fa-book"></i> Ebooks</h3></div>
    <div class="col-md-5">
      <form class="form-inline my-2" action="/search" method="get">
        <input class="form-control mr-2 flex-grow-1" name="q" type="search" placeholder="Search books or authors" aria-label="Search" required>
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
    </div>
    <div class="col-md-4 text-md-right">
      <% if (user) { %>
        <span class="mr-2">Hi, <%= user.name %></span>
        <% if (user.isAdmin) { %><a href="/admin" class="btn btn-warning">Admin</a><% } else { %><a href="/crt" class="btn btn-success mr-1">Cart</a><a href="/orders" class="btn btn-info mr-1">My Orders</a><% } %>
        <a href="/logout" class="btn btn-outline-danger">Logout</a>
      <% } else { %>
        <a href="/login" class="btn btn-success">Login</a>
        <a href="/register" class="btn btn-primary">Register</a>
      <% } %>
    </div>
  </div>
</div>
<nav class="navbar navbar-expand-lg navbar-dark bg-custom">
  <a class="navbar-brand" href="/">Home</a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="mainNav">
    <ul class="navbar-nav mr-auto">
      <li class="nav-item"><a class="nav-link" href="/recent">Recent Books</a></li>
      <li class="nav-item"><a class="nav-link" href="/new">New Books</a></li>
      <li class="nav-item"><a class="nav-link" href="/old">Old Books</a></li>
      <li class="nav-item"><a class="nav-link" href="/cu">Contact Us</a></li>
    </ul>
  </div>
</nav>
<style>.bg-custom{background:#e91e63}.navbar .nav-link:hover{background:#fff;color:#e91e63;border-radius:15px}</style>
