<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Orders</title><%- include("allCss.ejs") -%>
<style>
.timeline{display:flex;justify-content:space-between;gap:6px;margin:18px 0 8px}.step{flex:1;text-align:center;font-size:12px;color:#888}.dot{width:18px;height:18px;border-radius:50%;border:2px solid #bbb;margin:0 auto 6px;background:#fff}.step.active{color:#04AA6D;font-weight:600}.step.active .dot{background:#04AA6D;border-color:#04AA6D}.step.current{color:#007bff}.step.current .dot{background:#007bff;border-color:#007bff}.line{height:3px;background:#ddd;flex:1;margin-top:8px}.track{display:flex;align-items:flex-start}.order-card{border-radius:12px}.address-box{background:#f8f9fa;border-radius:8px;padding:12px}.item-row{border-bottom:1px solid #eee}.item-row:last-child{border-bottom:0}
</style>
</head>
<body class="bg-light"><%- include('navbar.ejs') -%>
<main class="container py-5"><h2>My Orders</h2>
<% if (payment === 'success') { %><div class="alert alert-success">Payment successful. Your order has been confirmed.</div><% } %>
<% if (payment === 'failed') { %><div class="alert alert-danger">Payment failed or was cancelled. Your cart has not been cleared, so you can try again.</div><% } %>
<% if (placed) { %><div class="alert alert-success">Order placed successfully!</div><% } %>
<% if (!orders.length) { %><div class="alert alert-info">You have not placed any orders yet.</div><% } %>
<% orders.forEach(function(order){
  const steps = ['Processing','Shipped','Out for Delivery','Delivered'];
  const currentIndex = steps.indexOf(order.status);
  const paid = order.paymentStatus === 'Success';
%>
<div class="card shadow-sm mb-4 order-card"><div class="card-body p-4">
  <div class="d-flex justify-content-between flex-wrap"><div><strong>Order #<%= order._id.toString().slice(-8).toUpperCase() %></strong><div class="text-muted"><%= new Date(order.createdAt).toLocaleString() %></div></div>
  <div class="text-right"><span class="badge badge-<%= order.status === 'Delivered' ? 'success' : (order.status === 'Cancelled' || order.status === 'Payment Failed' ? 'danger' : 'info') %>"><%= order.status %></span><div class="small text-muted mt-1">Payment: <%= order.paymentStatus %></div></div></div>

  <% if (paid && !['Cancelled','Payment Failed','Payment Pending'].includes(order.status)) { %>
    <div class="track mt-3">
      <% steps.forEach(function(step, i){ %>
        <div class="step <%= currentIndex >= i ? 'active' : '' %> <%= currentIndex === i ? 'current' : '' %>"><div class="dot"></div><div><%= step %></div></div>
        <% if (i < steps.length - 1) { %><div class="line"></div><% } %>
      <% }) %>
    </div>
  <% } %>
  <hr>
  <% order.items.forEach(function(item){ %><div class="d-flex justify-content-between py-2 item-row"><span><strong><%= item.bn %></strong> <small class="text-muted">by <%= item.an %></small></span><strong><%= formatPrice(item.pr) %></strong></div><% }) %>
  <hr><div class="address-box"><strong>Delivery Address</strong><br><%= order.shippingAddress.addressLine %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></div>
  <div class="text-right mt-3"><strong>Total: <%= formatPrice(order.total) %></strong></div>
</div></div>
<% }) %>
</main></body></html>
