<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= dt2.bname %></title><%- include('allCss.ejs') -%></head><body class="bg-light"><%- include('navbar.ejs') -%><main class="container py-5"><div class="row"><div class="col-md-5 mx-auto"><div class="card shadow-sm"><div class="card-body text-center"><img src="/img/<%= dt2.image %>" alt="<%= dt2.bname %>" style="width:220px;height:300px;object-fit:cover" class="mb-3"><h3><%= dt2.bname %></h3><p class="text-muted">by <%= dt2.aname %></p><p class="text-warning">★★★★★</p><p>Category: <%= dt2.categorie %></p><h4><%= formatPrice(dt2.price) %></h4><a href="<%= user ? '/adcrt/' + dt2._id : '/login' %>" class="btn btn-success"><%= user ? 'Add to Cart' : 'Login to Add' %></a><a href="/" class="btn btn-outline-secondary ml-2">Back</a></div></div></div></div></main></body></html>
