<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Ebook Login </title>
    <style>
        .crd-ho:hover {
	background-color: #d7dae0;
}
    </style>
    <%- include("allCss.ejs") -%>
</head>

<body style="background-color:#f0f1f2;">
    <%- include("nb3.ejs") -%>
    <br/><br/>
        <h1 style="text-align: center;">Hello Admin</h1>

        <div class="container-fluid ml-5">
            <div class="row">
                <div class="col-md-3 mt-5 mb-5 ml-3 pt-3 pb-5">
                    <div class="card crd-ho">
                        <div class="card-body text-center">
                            <i class="fa-solid fa-square-plus fa-2xl" style="color: #2a82c6;"></i><br/><br/>
                                    <h2 onclick="addBook()">Add Books</h2>
                        </div>
                    </div>
                </div>
            

                        <div class="col-md-3 mt-5 mb-5 ml-3 pt-3 pb-5">
                            <div class="card crd-ho">
                                <div class="card-body text-center">
                                    <i class="fa-solid fa-box-open fa-2xl" style="color: #FFD43B;"></i><br/><br/>
                                    <h2 onclick="viewOrd()">View Orders</h2>
                                    </div>
                                </div>
                            </div>

                        
                        <div class="col-md-3 mt-5 mb-5 ml-3 pt-3 pb-5">
                            <div class="card crd-ho">
                                <div class="card-body text-center">
                                    <i class="fa-solid fa-right-from-bracket fa-2xl" style="color: #2a82c6;"></i><br/><br/>
                                    <h2 onclick="lout()">Log out</h2>
                                    </div>
                            </div>
                        </div>

            </div>
        </div>
                        

    <%- include("f2.ejs") -%>
    <script>
        function lout(){
            window.location.href="/login"
        }
        function viewOrd(){
            window.location.href="/fetchall"
        }
        function addBook(){
            window.location.href="/adb"
        }
    </script>
</body>

</html>