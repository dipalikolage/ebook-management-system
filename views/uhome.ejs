<!DOCTYPE html>
<html>
<head>
<meta charset="ISO-8859-1">
<title>EBook index</title>
<%- include("allCss.ejs") -%>
<style type="text/css">
    .bg-custom{
	background-color: #e91e63;
}


.navbar .nav-item:hover .nav-link{
	background:white;
	color:#e91e63;
	border-radius:15px;
}
.back-img {
	background: url("/img/bi.jpeg");
	height: 50vh;
	width: 100%;
	background-size: cover;
	background-repeat: no-repeat;
}

.crd-ho:hover {
	background-color: #d7dae0;
}
</style>
</head>
<body style="background-color: #f5f7f6;">
	<%- include("nb2.ejs") -%>
	<div class="container-fluid back-img">
	</div>
	<div class="container-fluid">
		<h3 class="text-center">Recent Books</h3>
		<div class="row">
			<% rdata.forEach(function (items){ %>
				<div class="col-md-3">
					<div class="card crd-ho">
						<div class="card-body text-center">
							<img alt="" src="/img/<%= items.image %>" style="width: 150px; height: 200px"
								class="img-thumblin">
							<p>
								<%= items.bname %>
							</p>
							<p>
								<%= items.aname %>
							</p>
							<p>
								<i class="fa-solid fa-star" style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i>
							</p>
							<p>Categorie:<%= items.categorie %>
							</p>
							<div clas="row text-center">
								<a href="/add/<%= items._id %>" class="btn btn-danger btn-sm ml-2"><i
										class="fa-solid fa-cart-shopping" onclick="add()"></i>Add Cart</a> <a href="/view/<%= items._id %>"
									class="btn btn-success btn-sm ml-1">View Details</a> <a href=""
									class="btn btn-danger btn-sm ml-1"><i class="fa-solid fa-indian-rupee-sign"></i>
									<%= items.price %>
								</a>
							</div>
						</div>
					</div>
				</div>
				<% }) %>
		</div>
	</div>
	<div class="container-fluid">
		<h3 class="text-center">New Books</h3>
		<div class="row">
			<% ndata.forEach(function (it){ %>
				<div class="col-md-3">
					<div class="card crd-ho">
						<div class="card-body text-center">
							<img alt="" src="/img/<%= it.image %>" style="width: 150px; height: 200px"
								class="img-thumblin">
							<p>
								<%= it.bname %>
							</p>
							<p>
								<%= it.aname %>
							</p>
							<p>
								<i class="fa-solid fa-star" style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i>
							</p>
							<p>Categorie:<%= it.categorie %>
							</p>
							<div clas="row text-center">
								<a href="/add/<%= it._id %>" class="btn btn-danger btn-sm ml-2"><i
										class="fa-solid fa-cart-shopping" onclick="add()"></i>Add Cart</a> <a href="/view/<%= it._id %>"
									class="btn btn-success btn-sm ml-1">View Details</a> <a href=""
									class="btn btn-danger btn-sm ml-1"><i class="fa-solid fa-indian-rupee-sign"></i>
									<%= it.price %>
								</a>
							</div>
						</div>
					</div>
				</div>
				<% }) %>
		</div>
	</div>
	<div class="container-fluid">
		<h3 class="text-center">Old Books</h3>
		<div class="row">
			<% odata.forEach(function (ite){ %>
				<div class="col-md-3">
					<div class="card crd-ho">
						<div class="card-body text-center">
							<img alt="" src="/img/<%= ite.image %>" style="width: 150px; height: 200px"
								class="img-thumblin">
							<p>
								<%= ite.bname %>
							</p>
							<p>
								<%= ite.aname %>
							</p>
							<p>
								<i class="fa-solid fa-star" style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i><i class="fa-solid fa-star"
									style="color: #FFD43B;"></i>
							</p>
							<p>Categorie:<%= ite.categorie %>
							</p>
							<div clas="row text-center">
								<a href="/add/<%= ite._id %>" class="btn btn-danger btn-sm ml-2"><i
										class="fa-solid fa-cart-shopping" onclick="add()"></i>Add Cart</a> <a href="/view/<%= ite._id %>"
									class="btn btn-success btn-sm ml-1">View Details</a> <a href=""
									class="btn btn-danger btn-sm ml-1"><i class="fa-solid fa-indian-rupee-sign"></i>
									<%= ite.price %>
								</a>
							</div>
						</div>
					</div>
				</div>
				<% }) %>
		</div>
	</div>
	<%- include("footer.ejs") -%>
</body>
</html>