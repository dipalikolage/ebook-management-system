<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Customer Orders</title>
<%- include('allCss.ejs') -%>
<style>
.table-wrap{overflow-x:auto}.table{background:#fff}.table th{background:#04AA6D;color:#fff;white-space:nowrap}.items-list{margin:0;padding-left:18px;min-width:160px}.address{min-width:220px}.status-form{min-width:170px}.status-badge{font-size:.9rem}.payment-id{font-size:.75rem;word-break:break-all;max-width:180px}.empty{padding:35px}
</style>
</head>
<body class="bg-light">
<%- include('nb3.ejs') -%>
<main class="container-fluid py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="mb-1">Customer Orders</h2><p class="text-muted mb-0">Manage payment and delivery status.</p></div>
    <a href="/admin" class="btn btn-outline-secondary">Back to Admin</a>
  </div>

  <% if (!orders.length) { %>
    <div class="card shadow-sm"><div class="card-body text-center empty"><h4>No orders yet</h4><p class="text-muted mb-0">Customer orders will appear here after checkout.</p></div></div>
  <% } else { %>
  <div class="table-wrap">
    <table class="table table-bordered table-hover align-middle">
      <thead><tr>
        <th>Buyer</th><th>Mobile</th><th>Delivery Address</th><th>Books</th><th>Total</th><th>Payment</th><th>Order Status</th><th>Order Date</th>
      </tr></thead>
      <tbody>
      <% orders.forEach(function(order){
        const statusClass = order.status === 'Delivered' ? 'success' : (order.status === 'Cancelled' || order.status === 'Payment Failed' ? 'danger' : (order.status === 'Shipped' || order.status === 'Out for Delivery' ? 'info' : 'warning'));
      %>
        <tr>
          <td><strong><%= order.buyerName %></strong><br><small class="text-muted"><%= order.userEmail %></small></td>
          <td><%= order.buyerMobile || '-' %></td>
          <td class="address"><%= order.shippingAddress ? (order.shippingAddress.addressLine + ', ' + order.shippingAddress.city + ', ' + order.shippingAddress.state + ' - ' + order.shippingAddress.pincode) : '-' %></td>
          <td><ul class="items-list"><% order.items.forEach(function(item){ %><li><%= item.bn %> <small class="text-muted">(<%= formatPrice(item.pr) %>)</small></li><% }) %></ul></td>
          <td><strong><%= formatPrice(order.total) %></strong></td>
          <td>
            <span class="badge badge-<%= order.paymentStatus === 'Success' ? 'success' : (order.paymentStatus === 'Failed' ? 'danger' : 'warning') %>"><%= order.paymentStatus || 'Pending' %></span>
            <% if (order.razorpayPaymentId) { %><div class="payment-id text-muted mt-1">ID: <%= order.razorpayPaymentId %></div><% } %>
          </td>
          <td>
            <span class="badge badge-<%= statusClass %> status-badge"><%= order.status %></span>
            <% if (order.paymentStatus === 'Success' && order.status !== 'Cancelled') { %>
              <form method="post" action="/admin/orders/<%= order._id %>/status" class="status-form mt-2">
                <label class="small text-muted mb-1">Update delivery status</label>
                <select name="status" class="form-control form-control-sm" onchange="this.form.submit()" <%= order.status === 'Delivered' ? 'disabled' : '' %>>
                  <option value="Paid" <%= order.status === 'Paid' ? 'selected' : '' %> disabled>Paid</option>
                  <option value="Processing" <%= order.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                  <option value="Shipped" <%= order.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                  <option value="Out for Delivery" <%= order.status === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
                  <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                  <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                </select>
              </form>
            <% } %>
          </td>
          <td><%= new Date(order.createdAt).toLocaleString() %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>
</body>
</html>
